<Window x:Class="DoIt.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DoIt.Windows"
        Title="DoIt 전체 편집기" Width="760" Height="560" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" xml:lang="ko-KR">
    <Grid Margin="18" PreviewKeyDown="OnWindowKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Label x:Name="SearchLabel" Content="제목 검색" Target="{Binding ElementName=SearchBox}" />
            <ComboBox x:Name="SortBox" DockPanel.Dock="Right" Width="112" Margin="8,0,0,0"
                      AutomationProperties.Name="정렬" SelectedIndex="0">
                <ComboBoxItem Content="마감일순" />
                <ComboBoxItem Content="추가순" />
            </ComboBox>
            <TextBox x:Name="SearchBox" VerticalContentAlignment="Center"
                     AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}" />
        </DockPanel>

        <ScrollViewer x:Name="LmsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="160" Visibility="Collapsed">
            <local:LmsSection x:Name="LmsTasks" />
        </ScrollViewer>

        <Grid Grid.Row="2">
            <ListBox x:Name="Rows" AutomationProperties.Name="편집할 할 일 목록"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsBatchSelected, Mode=OneWay}" IsEnabled="{Binding IsWritable}"
                                      AutomationProperties.Name="{Binding BatchLabel}" Click="ToggleBatchItem" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding CompletionLabel}"
                                       Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Item.Title}" MouseLeftButtonDown="OnTitleMouseDown" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="{Binding DateLabel}" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding DayLabel}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource OverdueAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyResult" Text="찾는 할 일이 없어요" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="EditSelected" DockPanel.Dock="Left" Content="선택한 할 일 편집" Padding="10,5" Click="EditSelection" />
            <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" Style="{StaticResource MutedText}" />
        </DockPanel>

        <Border x:Name="DraftControls" Grid.Row="4" Visibility="Collapsed" Margin="0,10,0,0"
                Padding="8" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Label x:Name="TitleLabel" Content="제목" Padding="0,0,0,3" Target="{Binding ElementName=TitleBox}" />
                    <TextBox x:Name="TitleBox" VerticalContentAlignment="Center"
                             AutomationProperties.LabeledBy="{Binding ElementName=TitleLabel}" PreviewKeyDown="OnDraftKeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <Label x:Name="DueLabel" Content="마감일" Padding="0,0,0,3" Target="{Binding ElementName=DueBox}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DueBox" Width="104" VerticalContentAlignment="Center" ToolTip="연도-월-일"
                                 AutomationProperties.LabeledBy="{Binding ElementName=DueLabel}" PreviewKeyDown="OnDraftKeyDown" />
                        <Button x:Name="PickDate" Content="달력" Margin="5,0,0,0" Padding="6,3" Click="OpenCalendar"
                                AutomationProperties.Name="마감일 달력 열기" />
                        <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=PickDate}" Placement="Top" StaysOpen="False"
                               Opened="OnCalendarOpened">
                            <Border Padding="8" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
                                    PreviewKeyDown="OnCalendarKeyDown">
                                <StackPanel>
                                    <Calendar x:Name="DueCalendar" />
                                    <Button Content="날짜 선택" Padding="6,3" Margin="0,4,0,0" Click="ApplyCalendarDate" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="저장" Padding="8,3" Click="SaveEdit" />
                    <Button Content="취소" Padding="8,3" Margin="4,0,0,0" Click="CancelEdit" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="BatchControls" Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="BatchCount" Margin="0,0,10,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button Content="완료" Margin="0,0,5,0" Padding="8,4" Click="MarkDone" />
            <Button Content="미완료" Margin="0,0,5,0" Padding="8,4" Click="MarkIncomplete" />
            <Button x:Name="DeleteSelected" Content="삭제" Margin="0,0,5,0" Padding="8,4"
                    Foreground="{DynamicResource OverdueAccent}" Click="DeleteBatch" />
            <Button Content="선택 해제" Padding="8,4" Click="ClearBatch" />
        </StackPanel>
    </Grid>
</Window>
