<Window x:Class="DoIt.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoIt 전체 편집기" Width="760" Height="560" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" xml:lang="ko-KR"
        Background="{DynamicResource DoIt.Bg}" Foreground="{DynamicResource DoIt.Text}"
        FontFamily="{StaticResource DoIt.TextFont}"
        PreviewKeyDown="OnWindowKeyDown" PreviewMouseDown="OnWindowMouseDown">
    <Window.Resources>
        <!-- 편집기 전용 스타일. 색은 DynamicResource DoIt.*만 쓴다. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DoIt.Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- 행의 날짜 "M/d · D-day": 글자처럼 보이는 버튼. 누르면 달력 -->
        <Style x:Key="DateButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DoIt.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DoIt.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 위 도구줄: 검색창 + 정렬 세그먼트 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource DoIt.Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource DoIt.SegmentHost}"
                        VerticalAlignment="Center" AutomationProperties.Name="정렬">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SortDue" GroupName="EditorSort" Content="마감일순" IsChecked="True"
                                     Style="{StaticResource DoIt.Segment}" AutomationProperties.Name="마감일순 정렬" />
                        <RadioButton x:Name="SortAdded" GroupName="EditorSort" Content="추가순"
                                     Style="{StaticResource DoIt.Segment}" AutomationProperties.Name="추가순 정렬" />
                    </StackPanel>
                </Border>
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource DoIt.Input}" Tag="제목 검색" Padding="34,8,10,8"
                             FontSize="14" AutomationProperties.Name="제목 검색" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource DoIt.Icon}" FontSize="14" HorizontalAlignment="Left"
                               Margin="13,0,0,0" Foreground="{DynamicResource DoIt.Muted}" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 본문 -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="BodyPanel" Margin="0,8,0,16">
                <!-- LMS 과제: 보기·체크만 -->
                <StackPanel x:Name="LmsPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Margin="20,10,20,4">
                        <TextBlock Text="LMS 과제" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource LmsAccent}" />
                        <TextBlock Text="보기·체크만 가능" Margin="10,2,0,0" Style="{StaticResource DoIt.Small}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="LmsStatus" Margin="20,2,20,4" Visibility="Collapsed" TextWrapping="Wrap"
                               Style="{StaticResource DoIt.Small}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="LmsCheckError" Margin="20,2,20,4" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource OverdueAccent}" AutomationProperties.LiveSetting="Polite"
                               Text="과제 체크를 저장하지 못했습니다. 다시 시도해 주세요." />
                    <ItemsControl x:Name="LmsRows" Focusable="False" AutomationProperties.Name="LMS 과제 목록">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowLine}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="Check" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                                                  Style="{StaticResource DoIt.CircleCheck}" BorderBrush="{DynamicResource LmsAccent}"
                                                  IsChecked="{Binding Row.IsDone, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                                  AutomationProperties.Name="{Binding CompletionLabel}" Click="ToggleLmsDone" />
                                        <!-- 제목이 먼저 자리를 잡고, 과목 칩은 남은 폭에 붙는다 -->
                                        <DockPanel Grid.Column="1" LastChildFill="False" VerticalAlignment="Center">
                                            <TextBlock x:Name="Title" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="14"
                                                       Foreground="{DynamicResource DoIt.Text}" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Row.Item.Title}" ToolTip="{Binding Row.Item.Title}" />
                                            <Border x:Name="Chip" DockPanel.Dock="Left" Margin="8,0,8,0" VerticalAlignment="Center"
                                                    CornerRadius="5" Padding="6,1" Background="{DynamicResource DoIt.BlueSoft}">
                                                <TextBlock Text="{Binding CourseLabel}" FontSize="12" Foreground="{DynamicResource LmsAccent}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CourseLabel}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="Due" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource DoIt.Muted}" Text="{Binding DueLabel}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasCourse}" Value="False">
                                        <Setter TargetName="Chip" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource OverdueAccent}" />
                                        <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource OverdueAccent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Row.IsDone}" Value="True">
                                        <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource DoIt.Muted}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 내 할 일 -->
                <TextBlock Text="내 할 일" Margin="20,10,20,6" Style="{StaticResource SectionTitle}"
                           Foreground="{DynamicResource TodoAccent}" />
                <ItemsControl x:Name="Rows" Focusable="False" AutomationProperties.Name="편집할 할 일 목록">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowChrome" Style="{StaticResource RowLine}" PreviewKeyDown="OnRowKeyDown">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center"
                                              Style="{StaticResource DoIt.SquareCheck}"
                                              IsChecked="{Binding IsBatchSelected, Mode=OneWay}" IsEnabled="{Binding IsWritable}"
                                              AutomationProperties.Name="{Binding BatchLabel}" Click="ToggleBatchItem" />
                                    <CheckBox Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                                              Style="{StaticResource DoIt.CircleCheck}"
                                              IsChecked="{Binding Item.IsDone, Mode=OneWay}" IsEnabled="{Binding IsWritable}"
                                              AutomationProperties.Name="{Binding DoneLabel}" Click="ToggleTodoDone" />
                                    <TextBlock x:Name="Title" Grid.Column="2" VerticalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource DoIt.Text}" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Item.Title}" ToolTip="{Binding Item.Title}"
                                               MouseLeftButtonDown="OnTitleMouseDown" />
                                    <TextBox x:Name="TitleEditor" Grid.Column="2" Visibility="Collapsed"
                                             Style="{StaticResource DoIt.Input}" BorderBrush="{DynamicResource DoIt.Green}"
                                             FontSize="14" Padding="8,4" AutomationProperties.Name="{Binding EditLabel}"
                                             IsVisibleChanged="OnTitleEditorVisibleChanged" TextChanged="OnTitleEditorTextChanged"
                                             PreviewKeyDown="OnTitleEditorKeyDown" LostKeyboardFocus="OnTitleEditorLostFocus" />
                                    <TextBlock x:Name="EditError" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="2,4,0,0"
                                               FontSize="12" TextWrapping="Wrap" Text="{Binding EditError}" Visibility="Collapsed"
                                               Foreground="{DynamicResource OverdueAccent}" AutomationProperties.LiveSetting="Assertive" />
                                    <Button x:Name="DueButton" Grid.Column="3" Margin="10,0,2,0" VerticalAlignment="Center"
                                            Style="{StaticResource DateButton}" Content="{Binding DateLabel}"
                                            IsEnabled="{Binding IsWritable}" AutomationProperties.Name="{Binding DateButtonLabel}"
                                            ToolTip="마감일 바꾸기" Click="OpenCalendar" />
                                    <Button Grid.Column="4" Width="28" Height="28" FontSize="14" VerticalAlignment="Center"
                                            Style="{StaticResource DoIt.IconButton}" Content="&#xE70F;"
                                            IsEnabled="{Binding IsWritable}" AutomationProperties.Name="{Binding PencilLabel}"
                                            ToolTip="제목 수정" Click="EditTitle" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                    <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource DoIt.GreenSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Item.IsDone}" Value="True">
                                    <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource DoIt.Muted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter TargetName="DueButton" Property="Foreground" Value="{DynamicResource OverdueAccent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="TitleEditor" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="DueButton" Property="Foreground" Value="{DynamicResource DoIt.Green}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasEditError}" Value="True">
                                    <Setter TargetName="EditError" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyResult" Text="찾는 할 일이 없어요" Visibility="Collapsed" Margin="0,36,0,0"
                           HorizontalAlignment="Center" FontSize="14" Style="{StaticResource MutedText}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 상태 문구 (저장했습니다 등) -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="20,6,20,10" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Style="{StaticResource DoIt.Small}" />

        <!-- 일괄 막대: 아래 가운데에 떠 있다 -->
        <Border x:Name="BatchControls" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="16,0,16,14" Padding="8,6" CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource DoIt.Input}" BorderBrush="{DynamicResource DoIt.Edge}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="1"
                                  Color="{DynamicResource DoIt.ShadowColor}" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BatchCount" Margin="8,0,12,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource DoIt.Text}" AutomationProperties.LiveSetting="Polite" />
                <Button Content="완료" Margin="0,0,6,0" Style="{StaticResource DoIt.PillButton}" Click="MarkDone" />
                <Button Content="미완료" Margin="0,0,6,0" Style="{StaticResource DoIt.PillButton}" Click="MarkIncomplete" />
                <Button x:Name="DeleteSelected" Content="삭제" Margin="0,0,6,0" Style="{StaticResource DoIt.DangerButton}"
                        Click="DeleteBatch" />
                <Button Content="선택 해제" Style="{StaticResource DoIt.PillButton}" Click="ClearBatch" />
            </StackPanel>
        </Border>

        <!-- 날짜 고르기: 행의 날짜를 누르면 그 아래에 열린다. 고르면 바로 저장 -->
        <Popup x:Name="DatePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               Opened="OnCalendarOpened" Closed="OnCalendarClosed">
            <Border Margin="6" Padding="6" CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource DoIt.Input}" BorderBrush="{DynamicResource DoIt.Edge}"
                    PreviewKeyDown="OnCalendarKeyDown">
                <Calendar x:Name="DueCalendar" AutomationProperties.Name="마감일 달력"
                          PreviewMouseLeftButtonUp="OnCalendarMouseUp" />
            </Border>
        </Popup>
    </Grid>
</Window>
