<Window x:Class="DoIt.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DoIt.Windows"
        Title="DoIt 할 일" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" xml:lang="ko-KR">
    <Window.Resources>
        <!-- 달력 칸: 평소에는 투명, 마우스를 올리면 옅은 배경, 선택된 날은 코드에서 2px 테두리를 준다. -->
        <Style x:Key="CalendarCellStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- 글자색을 옅게 깔아 밝은·어두운 테마 모두에서 보이는 배경을 만든다. -->
                            <Border x:Name="Hover" CornerRadius="5" Opacity="0"
                                    Background="{TemplateBinding Foreground}" />
                            <Border x:Name="Selection" CornerRadius="5" Margin="2"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border x:Name="FocusRing" CornerRadius="5" BorderThickness="2" Visibility="Collapsed"
                                    BorderBrush="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Windows 11은 DWM이 바깥 모서리를 둥글게 자른다(코드). 1px 테두리도 같은 반경으로 맞춘다. -->
    <Border x:Name="PanelFrame" BorderThickness="1" CornerRadius="8"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
    <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="PanelContent" Margin="16,12,16,12">
            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ModeButton" Margin="0,0,6,0" Padding="10,5" Click="ToggleMode" />
                    <Button Content="전체 편집기…" Margin="0,0,6,0" Padding="10,5" Click="OpenEditor" />
                    <Button Content="설정" Padding="10,5" Click="OpenSettings" />
                </StackPanel>
                <TextBlock Text="DoIt" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
            </DockPanel>

            <StackPanel x:Name="CalendarView" Visibility="Collapsed">
                <TextBlock x:Name="MonthHeading" Style="{StaticResource Heading}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                    <Button Content="‹" AutomationProperties.Name="이전 달" Margin="0,0,6,0" Click="PreviousMonth" />
                    <Button Content="오늘" Margin="0,0,6,0" Click="GoToToday" />
                    <Button Content="›" AutomationProperties.Name="다음 달" Click="NextMonth" />
                </StackPanel>
                <UniformGrid x:Name="Weekdays" Columns="7" Margin="0,0,0,4" />
                <UniformGrid x:Name="CalendarGrid" Columns="7" Margin="0,0,0,10"
                             KeyboardNavigation.TabNavigation="Once"
                             KeyboardNavigation.DirectionalNavigation="Contained" />
            </StackPanel>

            <StackPanel x:Name="QuickAdd" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" AutomationProperties.Name="할 일 제목" Padding="8,5" />
                    <Button x:Name="DueDateButton" Grid.Column="1" Padding="6,3" Margin="6,0,0,0"
                            Click="ToggleDatePicker" />
                    <TextBlock x:Name="CalendarDueDate" Grid.Column="1" VerticalAlignment="Center"
                               Margin="6,0,0,0" Style="{StaticResource MutedText}" />
                    <Button Grid.Column="2" Content="추가" Padding="8,3" Margin="6,0,0,0" Click="AddTodo" />
                </Grid>
                <StackPanel x:Name="DueDatePicker" Visibility="Collapsed" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="PickTodayButton" Content="오늘" Tag="0" Padding="8,3" Margin="0,0,6,4" Click="PickRelativeDate" />
                        <Button Content="내일" Tag="1" Padding="8,3" Margin="0,0,6,4" Click="PickRelativeDate" />
                        <Button Content="+1주" Tag="7" Padding="8,3" Margin="0,0,6,4" Click="PickRelativeDate" />
                    </WrapPanel>
                    <Calendar x:Name="PickerCalendar" HorizontalAlignment="Left" />
                    <Button Content="날짜 선택" Padding="8,3" HorizontalAlignment="Left" Click="PickCalendarDate" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StorageError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{StaticResource OverdueAccent}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="PastDay" Text="지난 날짜는 보기만 할 수 있어요." Visibility="Collapsed"
                       Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <local:LmsSection x:Name="LmsTasks" />
            <TextBlock x:Name="TodoHeading" Style="{StaticResource Heading}" Margin="0,0,0,4" />
            <ItemsControl x:Name="TodoList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel x:Name="Row" Margin="0,4" Background="Transparent" MouseLeave="CancelDelete"
                                   LostKeyboardFocus="CancelDeleteOnFocusLoss">
                            <CheckBox x:Name="DoneToggle" DockPanel.Dock="Left" IsChecked="{Binding Item.IsDone, Mode=OneWay}"
                                      IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding CompletionLabel}"
                                      Click="ToggleTodo" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="{Binding DeleteLabel}"
                                    Visibility="{Binding DeleteVisibility}" AutomationProperties.Name="{Binding DeleteDescription}"
                                    Click="DeleteTodo" Padding="6,2" Opacity="0" Margin="6,0,0,0" />
                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Deadline" Text="{Binding DayLabel}" FontWeight="SemiBold" TextAlignment="Right" />
                                <TextBlock Text="{Binding DateLabel}" Style="{StaticResource MutedText}" TextAlignment="Right" />
                            </StackPanel>
                            <TextBlock x:Name="Title" Text="{Binding Item.Title}" TextWrapping="Wrap" ToolTip="{Binding Item.Title}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DeleteArmed}" Value="True">
                                <Setter TargetName="DeleteButton" Property="Foreground" Value="{StaticResource OverdueAccent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter TargetName="Deadline" Property="Foreground" Value="{StaticResource OverdueAccent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Item.IsDone}" Value="True">
                                <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Title" Property="Opacity" Value="0.65" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyDay" Text="할 일이 없어요." Visibility="Collapsed"
                       Style="{StaticResource MutedText}" />
        </StackPanel>
    </ScrollViewer>
    </Border>
</Window>
