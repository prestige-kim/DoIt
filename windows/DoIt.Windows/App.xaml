<Application x:Class="DoIt.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown" ThemeMode="System">
    <Application.Resources>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.72" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <SolidColorBrush x:Key="TodoAccent" Color="#3FBF7F" />
        <SolidColorBrush x:Key="LmsAccent" Color="#4978BE" />
        <SolidColorBrush x:Key="OverdueAccent" Color="#D44141" />
    </Application.Resources>
</Application>
