<Window x:Class="DoIt.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoIt 설정" WindowStartupLocation="CenterScreen"
        Width="560" Height="560" MinWidth="460" MinHeight="410"
        UseLayoutRounding="True" xml:lang="ko-KR">
    <TabControl x:Name="Sections" Margin="16">
        <TabItem Header="일반">
            <StackPanel Margin="16">
                <CheckBox x:Name="StartOnLogin" Content="로그인 시 DoIt 시작" Click="ToggleStartup" />
                <TextBlock x:Name="StartupStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="VersionLabel" Margin="0,24,0,0" TextWrapping="Wrap" />
                <Button Content="새 버전 확인" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0"
                        ToolTip="브라우저에서 DoIt Windows 설치 안내를 엽니다." Click="CheckForUpdate" />
                <TextBlock Text="새 버전 설치 파일을 실행하면 할 일과 설정은 그대로 두고 앱만 바꿉니다."
                           Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                <TextBlock x:Name="UpdateStatus" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource OverdueAccent}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </TabItem>
        <TabItem Header="LMS 연동">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <CheckBox x:Name="EnableLms" Content="LMS 연동" Click="ToggleLms" />
                    <TextBlock x:Name="FeedLabel" Margin="0,12,0,6" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                    <WrapPanel>
                        <Button x:Name="EditAddressButton" Content="피드 주소 입력" Padding="10,4" Margin="0,0,6,4" Click="EditAddress" />
                        <Button x:Name="DisconnectButton" Content="연결 해제…" Padding="10,4" Margin="0,0,0,4"
                                Foreground="{DynamicResource OverdueAccent}" Click="ConfirmDisconnect" />
                    </WrapPanel>
                    <StackPanel x:Name="AddressEditor" Visibility="Collapsed" Margin="0,8,0,12">
                        <Label x:Name="AddressLabel" Content="개인 캘린더 피드 주소" Target="{Binding ElementName=FeedAddressBox}" />
                        <PasswordBox x:Name="FeedAddressBox" Padding="8,5" AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="주소 저장" Padding="10,4" Margin="0,0,6,0" Click="SaveAddress" />
                            <Button Content="취소" Padding="10,4" Click="CancelAddress" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="DisconnectEditor" Visibility="Collapsed" Margin="0,8,0,12">
                        <TextBlock Text="이 PC에서 피드 주소를 삭제하고 LMS 연결을 해제할까요? 이미 보관한 기록은 남습니다." TextWrapping="Wrap" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="연결 해제" Padding="10,4" Margin="0,0,6,0" Foreground="{DynamicResource OverdueAccent}" Click="Disconnect" />
                            <Button Content="취소" Padding="10,4" Click="CancelDisconnect" />
                        </WrapPanel>
                    </StackPanel>
                    <DockPanel Margin="0,16,0,8" LastChildFill="False">
                        <Label x:Name="WeeksLabel" Content="가져올 기간" Target="{Binding ElementName=WeeksBox}" />
                        <ComboBox x:Name="WeeksBox" Width="84" AutomationProperties.LabeledBy="{Binding ElementName=WeeksLabel}" />
                    </DockPanel>
                    <Button x:Name="RefreshButton" Content="지금 새로고침" HorizontalAlignment="Left" Padding="10,4" Click="RefreshLms" />
                    <TextBlock x:Name="LmsStatus" Margin="0,8,0,4" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="LastRefresh" TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="LmsError" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource OverdueAccent}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="알림">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <CheckBox x:Name="TodoReminders" Content="내 할 일 마감 알림" Click="ToggleReminders" />
                    <CheckBox x:Name="LmsReminders" Content="LMS 과제 마감 알림" Margin="0,6,0,0" Click="ToggleReminders" />
                    <CheckBox x:Name="PauseReminders" Content="마감 알림 일시 중지" Margin="0,6,0,0" Click="ToggleReminders" />
                    <TextBlock x:Name="NextReminder" Margin="0,14,0,8" TextWrapping="Wrap" />
                    <Button x:Name="TestReminderButton" Content="테스트 알림 보내기" Padding="10,4"
                            HorizontalAlignment="Left" Click="TestReminder" />
                    <TextBlock x:Name="ReminderStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem x:Name="HistoryTab" Header="기록 보관">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <DockPanel LastChildFill="False">
                        <Label x:Name="RetentionLabel" Content="기록 보관 기간" Target="{Binding ElementName=RetentionBox}" />
                        <ComboBox x:Name="RetentionBox" Width="120" AutomationProperties.LabeledBy="{Binding ElementName=RetentionLabel}" />
                    </DockPanel>
                    <TextBlock x:Name="CleanupCount" Margin="0,10,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel>
                        <Button x:Name="CleanupButton" Content="지금 정리…" Padding="10,4" Margin="0,0,6,4" Click="ConfirmCleanup" />
                        <Button Content="모든 기록 초기화…" Padding="10,4" Margin="0,0,0,4" Click="ConfirmReset"
                                Foreground="{DynamicResource OverdueAccent}" />
                    </WrapPanel>
                    <StackPanel x:Name="CleanupEditor" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="정리할 기록을 백업할까요?" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="백업 후 정리" Padding="8,4" Margin="0,0,6,4" Click="CleanupWithBackup" />
                            <Button Content="그냥 정리" Padding="8,4" Margin="0,0,6,4" Click="CleanupWithoutBackup" />
                            <Button Content="나중에" Padding="8,4" Margin="0,0,0,4" Click="CancelCleanup" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="ResetEditor" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="ResetPrompt" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="ResetButton" Content="계속" Padding="8,4" Margin="0,0,6,4" Click="ResetHistory" />
                            <Button Content="취소" Padding="8,4" Margin="0,0,0,4" Click="CancelCleanup" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock x:Name="HistoryStatus" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="OpenArchiveButton" Content="백업 폴더 열기" HorizontalAlignment="Left" Padding="10,4"
                            Margin="0,8,0,0" Click="OpenArchive" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="저장 공간">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock x:Name="StorageLabel" TextWrapping="Wrap" />
                    <Button Content="새로 계산" HorizontalAlignment="Left" Padding="10,4" Margin="0,12,0,0" Click="RefreshStorage" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
