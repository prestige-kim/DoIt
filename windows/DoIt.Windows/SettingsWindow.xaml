<Window x:Class="DoIt.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoIt 설정" WindowStartupLocation="CenterScreen"
        Width="760" Height="540" MinWidth="640" MinHeight="440"
        Background="{DynamicResource DoIt.Bg}" Foreground="{DynamicResource DoIt.Text}"
        FontFamily="{StaticResource DoIt.TextFont}"
        UseLayoutRounding="True" xml:lang="ko-KR">
    <!-- T-035 묶음 S: 왼쪽 사이드바 + 오른쪽 제목·묶음 상자. 색은 DynamicResource DoIt.*로만 쓴다. -->
    <Window.Resources>
        <!-- 사이드바 항목: 아이콘+이름, 선택은 옅은 초록 바탕·초록 글자·SemiBold -->
        <Style x:Key="S.NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DoIt.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DoIt.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DoIt.GreenSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource DoIt.Green}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="S.NavIcon" TargetType="TextBlock" BasedOn="{StaticResource DoIt.Icon}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- 오른쪽 내용 -->
        <Style x:Key="S.Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="24,20,24,20" />
        </Style>
        <Style x:Key="S.PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Text}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <!-- 묶음 상자 안의 한 행: 왼쪽 제목+설명, 오른쪽 컨트롤 -->
        <Style x:Key="S.Row" TargetType="Grid">
            <Setter Property="Margin" Value="16,12" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style x:Key="S.RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="S.RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="S.RowSide" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style x:Key="S.Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DoIt.Line}" />
        </Style>
        <!-- 묶음 아래 작은 상태·오류 글자 -->
        <Style x:Key="S.Status" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,-8,4,12" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="S.Error" TargetType="TextBlock" BasedOn="{StaticResource S.Status}">
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Red}" />
        </Style>
        <!-- 묶음 아래에 펼쳐지는 확인·입력 줄 -->
        <Style x:Key="S.Confirm" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DoIt.Group}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DoIt.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,-6,0,14" />
        </Style>
        <!-- 행 전체 제목처럼 보이는 빨간 글자 버튼 (연결 해제…, 모든 기록 초기화…) -->
        <Style x:Key="S.DangerTitle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Red}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DoIt.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Text" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 가져올 기간 −/+ 작은 네모 버튼 -->
        <Style x:Key="S.StepButton" TargetType="Button" BasedOn="{StaticResource DoIt.PillButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <!-- 피드 주소 입력 (DoIt.Input과 같은 모양) -->
        <Style x:Key="S.PasswordInput" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Text}" />
            <Setter Property="Background" Value="{DynamicResource DoIt.Input}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DoIt.Edge}" />
            <Setter Property="CaretBrush" Value="{DynamicResource DoIt.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource DoIt.Green}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DoIt.Green}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 저장 공간 표의 칸 -->
        <Style x:Key="S.Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="S.HeadCell" TargetType="TextBlock" BasedOn="{StaticResource S.Cell}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Muted}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 사이드바 -->
        <Border BorderBrush="{DynamicResource DoIt.Line}" BorderThickness="0,0,1,0">
            <ListBox x:Name="Sections" Margin="12,16,12,12" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource S.NavItem}" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="설정 항목" SelectionChanged="ChangeSection">
                <ListBoxItem x:Name="GeneralTab" AutomationProperties.Name="일반" IsSelected="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource S.NavIcon}" Text="&#xE713;" />
                        <TextBlock Text="일반" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="LmsTab" AutomationProperties.Name="LMS 연동">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource S.NavIcon}" Text="&#xE8F1;" />
                        <TextBlock Text="LMS 연동" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="ReminderTab" AutomationProperties.Name="알림">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource S.NavIcon}" Text="&#xEA8F;" />
                        <TextBlock Text="알림" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="HistoryTab" AutomationProperties.Name="기록 보관">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource S.NavIcon}" Text="&#xE7B8;" />
                        <TextBlock Text="기록 보관" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="StorageTab" AutomationProperties.Name="저장 공간">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource S.NavIcon}" Text="&#xEDA2;" />
                        <TextBlock Text="저장 공간" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <!-- 오른쪽: 일반 -->
        <ScrollViewer x:Name="GeneralPage" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource S.Page}">
                <TextBlock Style="{StaticResource S.PageTitle}" Text="일반" />
                <Border Style="{StaticResource DoIt.Group}">
                    <Grid Style="{StaticResource S.Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource S.RowTitle}" Text="로그인 시 DoIt 시작" />
                            <TextBlock Style="{StaticResource S.RowDesc}" Text="Windows에 로그인하면 알림 영역에 DoIt이 켜져요" />
                        </StackPanel>
                        <CheckBox x:Name="StartOnLogin" Grid.Column="1" Style="{StaticResource DoIt.Switch}" Margin="16,0,0,0"
                                  VerticalAlignment="Center" AutomationProperties.Name="로그인 시 DoIt 시작" Click="ToggleStartup" />
                    </Grid>
                </Border>
                <TextBlock x:Name="StartupStatus" Style="{StaticResource S.Status}" AutomationProperties.LiveSetting="Polite" />

                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel>
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="새 버전 자동 확인" />
                                <TextBlock Style="{StaticResource S.RowDesc}" Text="하루 간격으로 새 버전을 확인해요. 설치는 직접 선택해요." />
                            </StackPanel>
                            <CheckBox x:Name="AutoUpdateCheck" Grid.Column="1" Style="{StaticResource DoIt.Switch}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" AutomationProperties.Name="새 버전 자동 확인" Click="ToggleAutoUpdate"
                                      ToolTip="하루 한 번 DoIt 소개 페이지의 버전 정보 파일을 확인합니다. 할 일 데이터는 보내지 않습니다." />
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="업데이트" />
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource S.RowDesc}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Style="{StaticResource S.RowSide}">
                                <Button x:Name="CheckUpdateButton" Content="새 버전 확인" Style="{StaticResource DoIt.PillButton}"
                                        ToolTip="지금 새 버전이 있는지 확인합니다." Click="CheckForUpdate" />
                                <Button x:Name="DownloadUpdateButton" Content="새 버전 받기" Style="{StaticResource DoIt.AccentButton}"
                                        Margin="8,0,0,0" Visibility="Collapsed"
                                        ToolTip="브라우저에서 이 PC에 맞는 설치 파일을 받습니다." Click="DownloadUpdate" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Style="{StaticResource S.Row}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="버전" />
                                <TextBlock x:Name="VersionLabel" Style="{StaticResource S.RowDesc}" />
                                <TextBlock x:Name="UpdateDetail" Style="{StaticResource S.RowDesc}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource S.Status}" Text="받은 설치 파일을 실행하면 할 일과 설정은 그대로 두고 앱만 바꿉니다." />
                <TextBlock x:Name="UpdateError" Style="{StaticResource S.Error}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>

        <!-- 오른쪽: LMS 연동 -->
        <ScrollViewer x:Name="LmsPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Style="{StaticResource S.Page}">
                <TextBlock Style="{StaticResource S.PageTitle}" Text="LMS 연동" />
                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel>
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="LMS 연동 켜기" />
                                <TextBlock Style="{StaticResource S.RowDesc}" Text="학교 LMS 캘린더 피드에서 과제를 읽어 와요 (읽기만 해요)" />
                            </StackPanel>
                            <CheckBox x:Name="EnableLms" Grid.Column="1" Style="{StaticResource DoIt.Switch}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" AutomationProperties.Name="LMS 연동" Click="ToggleLms" />
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="피드 주소" />
                                <TextBlock x:Name="FeedLabel" Style="{StaticResource S.RowDesc}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Style="{StaticResource S.RowSide}">
                                <StackPanel x:Name="FeedSaved" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                            Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource DoIt.Icon}" Text="&#xE72E;" FontSize="13" Margin="0,0,5,0"
                                               Foreground="{DynamicResource DoIt.Muted}" />
                                    <TextBlock Text="이 PC에만 저장됨" FontSize="13" Foreground="{DynamicResource DoIt.Muted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="EditAddressButton" Content="피드 주소 입력" Style="{StaticResource DoIt.PillButton}"
                                        Click="EditAddress" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="가져올 기간" />
                                <TextBlock Style="{StaticResource S.RowDesc}" Text="오늘부터 보여 줄 기간" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Style="{StaticResource S.RowSide}">
                                <Button x:Name="FewerWeeksButton" Content="−" Style="{StaticResource S.StepButton}"
                                        AutomationProperties.Name="가져올 기간 줄이기" Click="FewerWeeks" />
                                <TextBlock x:Name="WeeksValue" FontSize="15" FontWeight="SemiBold" MinWidth="44"
                                           TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DoIt.Text}"
                                           AutomationProperties.Name="가져올 기간" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="MoreWeeksButton" Content="+" Style="{StaticResource S.StepButton}"
                                        AutomationProperties.Name="가져올 기간 늘리기" Click="MoreWeeks" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="AddressEditor" Style="{StaticResource S.Confirm}" Visibility="Collapsed">
                    <StackPanel>
                        <Label x:Name="AddressLabel" Content="개인 캘린더 피드 주소" Padding="0,0,0,6" FontSize="13"
                               Foreground="{DynamicResource DoIt.Text}" Target="{Binding ElementName=FeedAddressBox}" />
                        <PasswordBox x:Name="FeedAddressBox" Style="{StaticResource S.PasswordInput}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="주소 저장" Style="{StaticResource DoIt.AccentButton}" Margin="0,0,8,0" Click="SaveAddress" />
                            <Button Content="취소" Style="{StaticResource DoIt.PillButton}" Click="CancelAddress" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DoIt.Group}">
                    <Grid Style="{StaticResource S.Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource S.RowTitle}" Text="마지막 동기화" />
                            <TextBlock x:Name="LastRefresh" Style="{StaticResource S.RowDesc}" />
                            <TextBlock x:Name="LmsStatus" Style="{StaticResource S.RowDesc}" Margin="0,1,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="지금 새로고침" Style="{StaticResource DoIt.PillButton}"
                                Margin="16,0,0,0" VerticalAlignment="Center" Click="RefreshLms" />
                    </Grid>
                </Border>
                <TextBlock x:Name="LmsError" Style="{StaticResource S.Error}" AutomationProperties.LiveSetting="Polite" />

                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel Margin="16,12">
                        <Button x:Name="DisconnectButton" Content="연결 해제…" Style="{StaticResource S.DangerTitle}"
                                Click="ConfirmDisconnect" />
                        <TextBlock Style="{StaticResource S.RowDesc}" Text="이 PC에서 피드 주소를 지워요. 보관한 기록은 남아요." />
                    </StackPanel>
                </Border>
                <Border x:Name="DisconnectEditor" Style="{StaticResource S.Confirm}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="이 PC에서 피드 주소를 삭제하고 LMS 연결을 해제할까요? 이미 보관한 기록은 남습니다."
                                   TextWrapping="Wrap" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="연결 해제" Style="{StaticResource DoIt.DangerButton}" Margin="0,0,8,0" Click="Disconnect" />
                            <Button Content="취소" Style="{StaticResource DoIt.PillButton}" Click="CancelDisconnect" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 오른쪽: 알림 -->
        <ScrollViewer x:Name="ReminderPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Style="{StaticResource S.Page}">
                <TextBlock Style="{StaticResource S.PageTitle}" Text="알림" />
                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel>
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="내 할 일 마감 알림" />
                                <TextBlock Style="{StaticResource S.RowDesc}" Text="마감 당일 오전 9시에 알려요" />
                            </StackPanel>
                            <CheckBox x:Name="TodoReminders" Grid.Column="1" Style="{StaticResource DoIt.Switch}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" AutomationProperties.Name="내 할 일 마감 알림" Click="ToggleReminders" />
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="LMS 과제 마감 알림" />
                                <TextBlock Style="{StaticResource S.RowDesc}" Text="마감 당일 오전 9시에 알려요" />
                            </StackPanel>
                            <CheckBox x:Name="LmsReminders" Grid.Column="1" Style="{StaticResource DoIt.Switch}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" AutomationProperties.Name="LMS 과제 마감 알림" Click="ToggleReminders" />
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="마감 알림 일시 중지" />
                                <TextBlock Style="{StaticResource S.RowDesc}" Text="켜 두면 마감 알림을 잠시 보내지 않아요" />
                            </StackPanel>
                            <CheckBox x:Name="PauseReminders" Grid.Column="1" Style="{StaticResource DoIt.Switch}" Margin="16,0,0,0"
                                      VerticalAlignment="Center" AutomationProperties.Name="마감 알림 일시 중지" Click="ToggleReminders" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel>
                        <Grid Style="{StaticResource S.Row}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="다음 알림" />
                                <TextBlock x:Name="NextReminder" Style="{StaticResource S.RowDesc}" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource S.RowTitle}" Text="테스트 알림" />
                                <TextBlock Style="{StaticResource S.RowDesc}" Text="Windows 알림 센터로 한 번 보내 봐요" />
                            </StackPanel>
                            <Button x:Name="TestReminderButton" Grid.Column="1" Content="테스트 알림 보내기"
                                    Style="{StaticResource DoIt.PillButton}" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Click="TestReminder" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ReminderStatus" Style="{StaticResource S.Status}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>

        <!-- 오른쪽: 기록 보관 -->
        <ScrollViewer x:Name="HistoryPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Style="{StaticResource S.Page}">
                <TextBlock Style="{StaticResource S.PageTitle}" Text="기록 보관" />
                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel>
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="RetentionLabel" Style="{StaticResource S.RowTitle}" Text="기록 보관 기간" />
                                <TextBlock Style="{StaticResource S.RowDesc}" Text="이 기간이 지난 완료 기록이 정리 대상이 돼요" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource DoIt.SegmentHost}" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel x:Name="RetentionBox" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle"
                                            AutomationProperties.LabeledBy="{Binding ElementName=RetentionLabel}">
                                    <RadioButton x:Name="RetentionSixMonths" Content="6개월" GroupName="Retention"
                                                 Style="{StaticResource DoIt.Segment}" Checked="ChangeRetention" />
                                    <RadioButton x:Name="RetentionOneYear" Content="1년" GroupName="Retention"
                                                 Style="{StaticResource DoIt.Segment}" Checked="ChangeRetention" />
                                    <RadioButton x:Name="RetentionTwoYears" Content="2년" GroupName="Retention"
                                                 Style="{StaticResource DoIt.Segment}" Checked="ChangeRetention" />
                                    <RadioButton x:Name="RetentionForever" Content="정리 안 함" GroupName="Retention"
                                                 Style="{StaticResource DoIt.Segment}" Checked="ChangeRetention" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Style="{StaticResource S.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="CleanupCount" Style="{StaticResource S.RowTitle}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="CleanupDetail" Style="{StaticResource S.RowDesc}" />
                            </StackPanel>
                            <Button x:Name="CleanupButton" Grid.Column="1" Content="지금 정리…" Style="{StaticResource DoIt.PillButton}"
                                    Margin="16,0,0,0" VerticalAlignment="Center" Click="ConfirmCleanup" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="CleanupEditor" Style="{StaticResource S.Confirm}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="정리할 기록을 백업할까요?" TextWrapping="Wrap" FontSize="13" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="백업 후 정리" Style="{StaticResource DoIt.AccentButton}" Margin="0,0,8,4" Click="CleanupWithBackup" />
                            <Button Content="그냥 정리" Style="{StaticResource DoIt.PillButton}" Margin="0,0,8,4" Click="CleanupWithoutBackup" />
                            <Button Content="나중에" Style="{StaticResource DoIt.PillButton}" Margin="0,0,0,4" Click="CancelCleanup" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel Margin="16,12">
                        <Button Content="모든 기록 초기화…" Style="{StaticResource S.DangerTitle}" Click="ConfirmReset" />
                        <TextBlock Style="{StaticResource S.RowDesc}"
                                   Text="완료한 할 일과 LMS 기록을 지워요. 미완료 할 일과 LMS 연결은 남아요." />
                    </StackPanel>
                </Border>
                <Border x:Name="ResetEditor" Style="{StaticResource S.Confirm}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResetPrompt" TextWrapping="Wrap" FontSize="13" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="ResetButton" Content="계속" Style="{StaticResource DoIt.DangerButton}" Margin="0,0,8,4"
                                    Click="ResetHistory" />
                            <Button Content="취소" Style="{StaticResource DoIt.PillButton}" Margin="0,0,0,4" Click="CancelCleanup" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="HistoryStatus" Style="{StaticResource S.Status}" Margin="4,0,4,10"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="OpenArchiveButton" Content="백업 폴더 열기" Style="{StaticResource DoIt.PillButton}"
                        HorizontalAlignment="Left" Click="OpenArchive" />
            </StackPanel>
        </ScrollViewer>

        <!-- 오른쪽: 저장 공간 -->
        <ScrollViewer x:Name="StoragePage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Style="{StaticResource S.Page}">
                <TextBlock Style="{StaticResource S.PageTitle}" Text="저장 공간" />
                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel>
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource S.HeadCell}" Text="파일" />
                            <TextBlock Grid.Column="1" Style="{StaticResource S.HeadCell}" Text="개수" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Style="{StaticResource S.HeadCell}" Text="크기" TextAlignment="Right" />
                        </Grid>
                        <ItemsControl x:Name="StorageRows" Focusable="False" AutomationProperties.Name="파일별 저장 공간">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource S.Divider}" />
                                        <Grid Margin="16,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource S.Cell}" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource S.Cell}" Text="{Binding Count}"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource S.Cell}" Text="{Binding Size}"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DoIt.Group}">
                    <StackPanel>
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource S.Cell}" Text="합계" FontWeight="SemiBold" />
                            <TextBlock x:Name="StorageTotal" Grid.Column="1" Style="{StaticResource S.Cell}" FontWeight="SemiBold" />
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource S.Cell}" Text="정리 대상" />
                            <TextBlock x:Name="StorageCleanup" Grid.Column="1" Style="{StaticResource S.Cell}" />
                        </Grid>
                        <Border Style="{StaticResource S.Divider}" />
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource S.Cell}" Text="DoIt 메모리" />
                            <TextBlock x:Name="StorageMemory" Grid.Column="1" Style="{StaticResource S.Cell}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Button Content="새로 계산" Style="{StaticResource DoIt.PillButton}" HorizontalAlignment="Left" Click="RefreshStorage" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
