<UserControl x:Class="DoIt.Windows.LmsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Margin="0,0,0,4">
    <UserControl.Resources>
        <!-- 접기 머리: Expander 기본 모양 대신 투명한 토글 버튼. 키보드 포커스는 공통 초록 테두리. -->
        <Style x:Key="LmsHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DoIt.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DoIt.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,4">
            <TextBlock x:Name="SyncInfo" DockPanel.Dock="Right" Style="{StaticResource DoIt.Small}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            <ToggleButton x:Name="Section" IsChecked="True" Style="{StaticResource LmsHeaderToggle}"
                          HorizontalAlignment="Left" Checked="OnExpansion" Unchecked="OnExpansion">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource DoIt.IconFont}" FontSize="10"
                               Foreground="{DynamicResource DoIt.Muted}" VerticalAlignment="Center" Width="14" />
                    <TextBlock x:Name="HeadingText" Text="LMS 과제" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource DoIt.Blue}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource DoIt.Badge}" Background="{DynamicResource DoIt.BlueSoft}" Margin="8,0,0,0">
                        <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DoIt.Blue}" />
                    </Border>
                </StackPanel>
            </ToggleButton>
        </DockPanel>
        <StackPanel x:Name="Body">
            <TextBlock x:Name="SyncStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                       Style="{StaticResource DoIt.Small}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="CheckError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12"
                       Foreground="{DynamicResource DoIt.Red}" AutomationProperties.LiveSetting="Polite"
                       Text="과제 체크를 저장하지 못했습니다. 다시 시도해 주세요." />
            <ItemsControl x:Name="Rows" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBg" CornerRadius="8" MinHeight="44" Padding="10,5" Margin="-10,0,-10,2"
                                Background="Transparent">
                            <DockPanel>
                                <CheckBox x:Name="Check" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"
                                          Style="{StaticResource DoIt.CircleCheck}" BorderBrush="{DynamicResource DoIt.Blue}"
                                          IsEnabled="{Binding CanToggle}" IsChecked="{Binding Row.IsDone, Mode=OneWay}"
                                          AutomationProperties.Name="{Binding CompletionLabel}" Click="ToggleDone" />
                                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="{Binding DateDetail}">
                                    <TextBlock x:Name="Deadline" Text="{Binding DayLabel}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource DoIt.Blue}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding DateLabel}" FontSize="12" Foreground="{DynamicResource DoIt.Muted}"
                                               TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="Title" Text="{Binding Row.Item.Title}" FontSize="15"
                                               Foreground="{DynamicResource DoIt.Text}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Row.Item.Title}" />
                                    <TextBlock x:Name="Course" Text="{Binding CourseLabel}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource DoIt.Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding CourseLabel}" Value="">
                                <Setter TargetName="Course" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource DoIt.RedSoft}" />
                                <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource DoIt.Red}" />
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource DoIt.Red}" />
                                <Setter TargetName="Deadline" Property="Foreground" Value="{DynamicResource DoIt.Red}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Row.IsDone}" Value="True">
                                <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource DoIt.Muted}" />
                                <Setter TargetName="Deadline" Property="Foreground" Value="{DynamicResource DoIt.Muted}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
